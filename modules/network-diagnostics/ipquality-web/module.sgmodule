#!name=IP 质量检测 · Web 扩展
#!desc=彩色 HTML 详细报告：http://ipquality.surge.local/web 。面板可手动生成报告。无需 MITM。
#!category=网络诊断
#!arguments=policy_group:✈️ 我的节点（所有订阅）,mask_ip:false
#!arguments-desc=填写现有节点或策略组；mask_ip 控制隐藏出口 IP。通过报告页按钮按需检测。
#!homepage=https://github.com/yixiay/Surge-Modules

[Host]
ipquality.surge.local = 127.0.0.1

[Script]
ipquality-web-panel = type=generic,script-path=https://raw.githubusercontent.com/yixiay/Surge-Modules/main/modules/network-diagnostics/ipquality-web/report.js,argument="policy={{{policy_group}}}&mask={{{mask_ip}}}",timeout=55
ipquality-web-report = type=http-request,pattern=^http://ipquality\.surge\.local/web(?:/|$|\?),script-path=https://raw.githubusercontent.com/yixiay/Surge-Modules/main/modules/network-diagnostics/ipquality-web/report.js,argument="policy={{{policy_group}}}&mask={{{mask_ip}}}",timeout=55,requires-body=false

[Panel]
ipquality-web = script-name=ipquality-web-panel,update-interval=3600
